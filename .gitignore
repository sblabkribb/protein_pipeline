# --- Requested exclusions (repo root) ---
/alphafold2/
/mmseqs-runpod/
/ProteinMPNN-runpod/
/colabfold-runpod/
/esm-runpod/
/simplefold-runpod/
rfd3-runpod/
/diffdock_runpod/
/bioemu-runpod/
/relax_runpod/
# --- Pipeline outputs ---
/outputs/
/cath_outputs/
/cath_embeddings.npy
/data/
/logs/*
!/logs/.gitkeep
/_ops/
/_ops/jobs/
/batch_success_*.csv
/batch_failed_*.csv
/batch_status.csv

# --- Local scratch / artifacts ---
/tmp/
/.codex
/pipeline-mcp/tests/_tmp/
/pytest-cache-files-*/
/pipeline-mcp/pytest-cache-files-*/
*.pdb
# 폴드 모델 좌표는 저장소에 넣지 않는다. 원격 사본은 S3 에 있고
# 목록과 sha256 은 public_data/benchmark/gate0/fold_artifact_archive.json
# 에 있다 (28_archive_fold_artifacts.py).
*.pdb.gz
*.cif
*.cif.gz
*.sdf
*.mol
*.mol2
*.smiles
*.smi
*.fasta
*.fa
*.a3m
*.tsv
*.pdf
!/figures/benchmark/*.pdf
*.json
!/frontend/package-lock.json
# 모델 레지스트리의 런타임 미러. 산출물이 아니라 배포되어야 하는 소스다 -
# 이 파일이 없으면 서비스가 YAML 로 넘어가고 PyYAML 없는 환경에서 죽는다.
!/pipeline-mcp/src/pipeline_mcp/model_registry/*.json
/af2_wt_*_job.json

# --- Public release package allowlist ---
!/public_data/**/*.json
!/public_data/**/*.fasta
!/public_data/**/*.pdb

# --- Python ---
__pycache__/
*.py[cod]
*.pyd
.Python
.venv/
venv/
ENV/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Env / secrets ---
.env
.env.*
*.pem
*.key

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.worktrees/

# --- Frontend ---
/frontend/node_modules/
/frontend/dist/

# --- docs ---
manuscript (5).docx
manuscript (5).md

# Internal dev artifacts — kept on disk / worker, not published to the repo.
# (Public setup/reproduction/architecture docs in docs/ stay tracked.)
/docs/plans/
/docs/superpowers/
/docs/2026-04-15-meta-surrogate-prototype-results/
/docs/2026-04-24-meta-surrogate-bias-analysis-ko.md
/docs/veo_video_scenario.md
/docs/veo_video_scenario_slides.md
/docs/project_intake_system_paper.md
# Binary manuscript exports — Markdown sources stay tracked.
/docs/manuscript.docx
/docs/supplementary.docx
# Superseded figure assets.
/figures/benchmark/_legacy/

# Agent / dev tooling — local only, not published.
/.claude/
/.agents/
/AGENT.md
/todo.md

# CATH 원본 분류 파일(43MB)은 추적하지 않는다.
# 재현에 필요한 것은 sha256 과 파생 매핑(rapid_target_superfamily.json)이다.
/public_data/cath/cath-domain-list.txt

# 내부 초안·탐색 산출물. 논문 자산이 아니고 재현에도 필요 없다.
# 원고 그림(figures/submission, figures/benchmark/figure1_orchestration.*,
# table*.tex)과 실험 데이터(public_data/benchmark/gate0/**)는 계속 추적한다.
/docs/figures/email_draft*.md
/docs/figures/*_bundle/
/docs/figures/expl_*
/figures/benchmark/*_v[0-9]*_[0-9]*.png
/figures/benchmark/*_email.png
/AGENTS.md

# 파생 산출물 - 스크립트로 다시 만들 수 있다.
/frontend/.pytest_cache/
/frontend/dist/
